# Copy to .env.local and fill in.

# --- Backend (Node/Express + Socket.io) ---
# REST base URL. In dev leave as '/api' (Vite proxies it to the backend, avoiding
# CORS). The proxy target defaults to http://localhost:8080 (override with
# VITE_API_PROXY_TARGET). In production set this to the backend's public URL.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080

# Socket.io server URL (real-time chat + call signaling).
VITE_SOCKET_URL=http://localhost:8080

# --- VideoSDK ---
# Auth token (https://app.videosdk.live/ -> API Keys).
VITE_VIDEOSDK_TOKEN=

# --- PSL recognition (Python inference server) ---
VITE_PSL_WS_URL=ws://localhost:8000/ws
VITE_RECOGNITION_FPS=15
VITE_RECOGNITION_FRAME_WIDTH=480
