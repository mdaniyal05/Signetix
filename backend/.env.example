PORT=8080

NODE_ENV=development

MONGO_DB_URL=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/signetix

JWT_SECRET_ACCESS_TOKEN_SECRET_KEY_ENCRYPTED=base64-encoded-secret
JWT_SECRET_REFRESH_TOKEN_SECRET_KEY=base64-encoded-secret
JWT_ACCESS_TOKEN_EXPIRATION_IN_DAYS=1
JWT_REFRESH_TOKEN_EXPIRATION_IN_DAYS=7

CORS_ALLOWED_ORIGINS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
