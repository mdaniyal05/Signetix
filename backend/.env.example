CLOUDINARY_PROFILE_PICTURES_FOLDER=signetix/profile-pictures
CLOUDINARY_MEDIA_FOLDER=signetix/media

RESEND_API_KEY=
RESEND_FROM_EMAIL=Signetix <no-reply@yourdomain.com>

# Web push (notifications). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

TWILIO_ACCOUNT_SID_ENCRYPTED=
TWILIO_ACCOUNT_AUTH_TOKEN_ENCRYPTED=
